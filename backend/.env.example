# MongoDB connection string (database name is taken from MONGO_DB)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=mycofarm
# Secret used to sign JWTs - change in any shared environment
JWT_SECRET_KEY=change-me-in-production
# Access token lifetime in minutes, refresh token lifetime in days
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Platform super admin - created on startup (if missing) and by seed.py
SUPERADMIN_NAME=Platform Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-strong-password

# Demo mode: seeds demo users and exposes them to the login page's "Demo accounts" drawer.
# Set DEMO_MODE=false in any real deployment.
DEMO_MODE=true
DEMO_PASSWORD=password123
